# npm run setup generates a random local secret and preserves an existing .env.
APP_URL=http://localhost:3000
JWT_SECRET=replace-with-at-least-32-random-characters
SQLITE_PATH=.data/loopa.db
UPLOAD_DIR=.data/uploads
TRUST_PROXY=false

# Optional shared rate limits and realtime pub/sub.
# REDIS_URL=redis://localhost:6379

# Required for actual delivery and npm start. Run npm run mail:worker too.
# SMTP_URL=smtps://username:password@mail.example.com:465
# MAIL_FROM=LOOPA <noreply@example.com>

# Optional OAuth. Configure provider callback URLs as well.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Runtime uses SQLITE_PATH, not DATABASE_URL. Prisma files are legacy references.

