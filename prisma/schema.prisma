// LOOPA — Database Schema
// -----------------------------------------------------------------------
// Dev default: SQLite (zero-config, file-based, runs anywhere — good for
// this sandbox and for `npm run dev` on any machine with no services).
//
// Production: switch `provider` below to "postgresql" and set DATABASE_URL
// to a Postgres connection string. SQLite does not support native enums,
// arrays, or full-text search, so string fields below are documented with
// their intended enum values (validated at the Zod layer in src/lib/validation)
// — on Postgres you can promote them to real `enum` types with a migration.
// -----------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================= IDENTITY =================================

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  emailVerifiedAt   DateTime?
  username          String   @unique
  passwordHash      String
  role              String   @default("user") // user | moderator | admin
  status            String   @default("active") // active | deactivated | suspended | deleted
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  profile           Profile?
  sessions          Session[]
  posts             Post[]
  comments          Comment[]
  likes             Like[]
  saves             Save[]
  moments           Moment[]
  hostedEvents      Event[]            @relation("EventHost")
  eventAttendance   EventAttendee[]
  communities       CommunityMember[]
  ownedCommunities  Community[]        @relation("CommunityOwner")

  followedBy        Follow[]           @relation("Following")
  following         Follow[]           @relation("Followers")

  connectionsSent   Connection[]       @relation("ConnectionRequester")
  connectionsRecvd  Connection[]       @relation("ConnectionAddressee")

  blockedBy         Block[]            @relation("BlockedUser")
  blocking          Block[]            @relation("BlockingUser")
  mutedBy            Mute[]            @relation("MutedUser")
  muting            Mute[]             @relation("MutingUser")

  notifications     Notification[]     @relation("NotificationRecipient")
  notificationsSent Notification[]     @relation("NotificationActor")

  conversations     ConversationMember[]
  messages          Message[]

  reportsFiled      Report[]           @relation("ReportedBy")
  reportsAgainst    Report[]           @relation("ReportedUser")

  collections       Collection[]
  interests         UserInterest[]
  hashtagFollows    HashtagFollow[]
  auditLogs         AuditLog[]
  refreshTokens     RefreshToken[]
  emailTokens       EmailVerificationToken[]
  passwordResets    PasswordResetToken[]
  notificationPreference NotificationPreference?
  oauthAccounts     OAuthAccount[]

  @@index([username])
  @@index([email])
}

model Profile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName   String
  avatarUrl     String?
  coverUrl      String?
  bio           String?
  location      String?
  website       String?
  skills        String?  // comma-separated; promote to join table if querying by skill becomes common
  privacy       String   @default("public") // who can view: public | followers | private
  dmPolicy      String   @default("everyone") // everyone | followers | none
  followPolicy  String   @default("open") // open | approval_required
  commentPolicy String   @default("everyone") // everyone | followers | none
  mentionPolicy String   @default("everyone") // everyone | followers | none
  latitude      Float?   // opt-in precise location, set only via "Use my location"
  longitude     Float?   // — used for Haversine-distance "Nearby", never shown to other users
  updatedAt     DateTime @updatedAt
}

// Short-lived, single-use tokens — never store raw session secrets in the DB.
model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?

  @@index([userId])
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?

  @@index([userId])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  usedAt    DateTime?
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  usedAt    DateTime?
}

// ============================ SOCIAL GRAPH ===============================

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  follower    User     @relation("Followers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
  @@index([followerId])
}

model Connection {
  id           String   @id @default(cuid())
  requesterId  String
  addresseeId  String
  requester    User     @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee    User     @relation("ConnectionAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status       String   @default("pending") // pending | accepted | declined
  createdAt    DateTime @default(now())
  respondedAt  DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

model Block {
  id           String   @id @default(cuid())
  blockingId   String
  blockedId    String
  blocking     User     @relation("BlockingUser", fields: [blockingId], references: [id], onDelete: Cascade)
  blocked      User     @relation("BlockedUser", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@unique([blockingId, blockedId])
}

model Mute {
  id         String   @id @default(cuid())
  mutingId   String
  mutedId    String
  muting     User     @relation("MutingUser", fields: [mutingId], references: [id], onDelete: Cascade)
  muted      User     @relation("MutedUser", fields: [mutedId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([mutingId, mutedId])
}

model UserInterest {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic     String
  weight    Float  @default(1.0) // used by ranking/discovery

  @@unique([userId, topic])
  @@index([topic])
}

// ============================== CONTENT ==================================

model Post {
  id           String   @id @default(cuid())
  authorId     String
  author       User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  communityId  String?
  community    Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)
  type         String   // text | image | video | question | poll | event_share
  body         String?
  visibility   String   @default("public") // public | followers | friends | private
  location     String?
  status       String   @default("published") // draft | published | removed | under_review
  pinned       Boolean  @default(false)
  commentPolicy String  @default("everyone") // everyone | followers | none — overrides profile default per-post
  likeCount    Int      @default(0)
  commentCount Int      @default(0)
  shareCount   Int      @default(0)
  saveCount    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  media        PostMedia[]
  poll         Poll?
  comments     Comment[]
  likes        Like[]
  saves        Save[]
  hashtags     PostHashtag[]
  reports      Report[]

  @@index([authorId, createdAt])
  @@index([communityId, createdAt])
  @@index([status, createdAt])
}

model PostMedia {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  kind       String   // image | video
  // Object storage architecture: only keys/URLs are stored relationally.
  // See src/services/storage — swap the provider without touching this table.
  storageKey String
  url        String
  thumbnailUrl String?
  width      Int?
  height     Int?
  durationMs Int?
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([postId])
}

model Poll {
  id        String       @id @default(cuid())
  postId    String       @unique
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  question  String
  closesAt  DateTime?
  options   PollOption[]
}

model PollOption {
  id       String @id @default(cuid())
  pollId   String
  poll     Poll   @relation(fields: [pollId], references: [id], onDelete: Cascade)
  label    String
  votes    PollVote[]
}

model PollVote {
  id        String     @id @default(cuid())
  optionId  String
  option    PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime   @default(now())

  @@unique([optionId, userId])
}

model Comment {
  id         String   @id @default(cuid())
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies    Comment[] @relation("CommentReplies")
  body       String
  status     String   @default("published") // published | removed | under_review
  likeCount  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  likes      Like[]
  reports    Report[]

  @@index([postId, createdAt])
  @@index([parentId])
}

model Like {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId     String?
  post       Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId  String?
  comment    Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@index([postId])
  @@index([commentId])
}

model Save {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId       String
  post         Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  collectionId String?
  collection   Collection?  @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  createdAt    DateTime     @default(now())

  @@unique([userId, postId])
}

model Collection {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())
  saves     Save[]
  items     CollectionItem[]

  @@index([userId])
}

// Generic saved-item table for saving events/communities (posts use `Save` above
// for backward-compat with the simple save flow; this table generalizes it).
model CollectionItem {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  itemType     String     // event | community
  itemId       String
  createdAt    DateTime   @default(now())

  @@unique([collectionId, itemType, itemId])
}

model Hashtag {
  id        String   @id @default(cuid())
  tag       String   @unique
  useCount  Int      @default(0)
  createdAt DateTime @default(now())

  posts     PostHashtag[]
  followers HashtagFollow[]

  @@index([useCount])
}

model PostHashtag {
  postId    String
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtagId String
  hashtag   Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@id([postId, hashtagId])
  @@index([hashtagId])
}

model HashtagFollow {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hashtagId String
  hashtag   Hashtag  @relation(fields: [hashtagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, hashtagId])
}

// ============================= MOMENTS ====================================

model Moment {
  id         String   @id @default(cuid())
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  kind       String   // photo | video | text
  mediaUrl   String?
  text       String?
  createdAt  DateTime @default(now())
  expiresAt  DateTime // createdAt + 24h, enforced at write time

  reactions  MomentReaction[]
  replies    MomentReply[]

  @@index([authorId, expiresAt])
  @@index([expiresAt])
}

model MomentReaction {
  id        String   @id @default(cuid())
  momentId  String
  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  @@unique([momentId, userId, emoji])
}

model MomentReply {
  id        String   @id @default(cuid())
  momentId  String
  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  userId    String
  body      String
  createdAt DateTime @default(now())
}

// ============================ COMMUNITIES =================================

model Community {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  iconUrl     String?
  coverUrl    String?
  privacy     String   @default("public") // public | private | invite_only
  rules       String?
  ownerId     String
  owner       User     @relation("CommunityOwner", fields: [ownerId], references: [id])
  memberCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  members     CommunityMember[]
  posts       Post[]
  events      Event[]
  reports     Report[]

  @@index([privacy])
}

model CommunityMember {
  id          String    @id @default(cuid())
  communityId String
  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("member") // owner | admin | moderator | member
  status      String    @default("active") // active | banned | pending (invite-only join requests)
  joinedAt    DateTime  @default(now())

  @@unique([communityId, userId])
  @@index([userId])
}

// ============================== EVENTS =====================================

model Event {
  id           String   @id @default(cuid())
  hostId       String
  host         User     @relation("EventHost", fields: [hostId], references: [id], onDelete: Cascade)
  communityId  String?
  community    Community? @relation(fields: [communityId], references: [id], onDelete: SetNull)
  title        String
  description  String?
  coverUrl     String?
  category     String?
  mode         String   // online | offline
  location     String?
  onlineUrl    String?
  latitude     Float?
  longitude    Float?
  startAt      DateTime
  endAt        DateTime?
  capacity     Int?
  status       String   @default("scheduled") // scheduled | cancelled | completed
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  attendees    EventAttendee[]
  reports      Report[]

  @@index([startAt])
  @@index([communityId])
}

model EventAttendee {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    String   @default("going") // going | interested | invited | declined
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([userId])
}

// ============================= MESSAGING ====================================

model Conversation {
  id         String   @id @default(cuid())
  isGroup    Boolean  @default(false)
  title      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  members    ConversationMember[]
  messages   Message[]
}

model ConversationMember {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  kind           String       @default("text") // text | image | video | file
  body           String?
  mediaUrl       String?
  replyToId      String?
  replyTo        Message?     @relation("MessageReplies", fields: [replyToId], references: [id])
  repliesTo      Message[]    @relation("MessageReplies")
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?

  reactions      MessageReaction[]

  @@index([conversationId, createdAt])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
}

// ============================ NOTIFICATIONS ===================================

model Notification {
  id          String   @id @default(cuid())
  recipientId String
  recipient   User     @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  type        String   // like | comment | follow | connection_request | message | mention | community_activity | event_reminder | invitation | moderation_action
  entityType  String?  // post | comment | community | event | message
  entityId    String?
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
}

// ============================ MODERATION & SAFETY ==============================

model Report {
  id            String   @id @default(cuid())
  reporterId    String
  reporter      User     @relation("ReportedBy", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId String?
  reportedUser  User?    @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  postId        String?
  post          Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId     String?
  comment       Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  communityId   String?
  community     Community? @relation(fields: [communityId], references: [id], onDelete: Cascade)
  eventId       String?
  event         Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reason        String
  details       String?
  status        String   @default("pending") // pending | reviewing | actioned | dismissed
  resolvedById  String?
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())

  @@index([status, createdAt])
}

// Per-user toggles for which notification types get created. Checked once,
// centrally, by notifyIfEnabled() in src/lib/notifications.ts — no other
// code path inserts a Notification row directly. Missing row = all enabled
// (the defaults below). moderation_action is intentionally never checked
// by that helper — an account-status notice isn't user-silenceable.
model NotificationPreference {
  userId             String  @id
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes              Boolean @default(true)
  comments           Boolean @default(true)
  follows            Boolean @default(true)
  connectionRequest  Boolean @default(true)
  messages           Boolean @default(true)
  mentions           Boolean @default(true)
  communityActivity  Boolean @default(true)
  eventReminder      Boolean @default(true)
  invitation         Boolean @default(true)
  moderationAction   Boolean @default(true)
  pushEnabled        Boolean @default(true)
}

// Links an external identity (Google/GitHub) to a LOOPA user. The pair
// (provider, providerAccountId) is globally unique: one external identity
// can only ever belong to one account.
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String   // google | github
  providerAccountId String
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String   // e.g. "user.suspend", "post.remove", "community.delete"
  targetType String?
  targetId   String?
  metadata   String?  // JSON string; kept free-form to avoid schema churn for audit detail
  createdAt  DateTime @default(now())

  @@index([action, createdAt])
}
